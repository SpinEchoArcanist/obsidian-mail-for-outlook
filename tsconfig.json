{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": false,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": false,
		"isolatedModules": true,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"types": ["node"],
		"lib": ["DOM", "ES5", "ES6", "ES7", "ES2020"]
	},
	"include": ["**/*.ts"]
}
